PORT=3000
NODE_ENV=production
MONGO_URI=mongodb+srv://trustlabledger:trustlab@123@cluster0.acpeurd.mongodb.net/ledgertrace
JWT_SECRET=change-this-to-a-random-string

# ─── MLD (Master List of Documents) — read from the DOMAS MySQL DB ───
# LedgerTrace itself runs on MongoDB; the MLD tab talks straight to the
# DOMAS MySQL catalog. All MLD_DB_* vars are required in production.
MLD_DB_HOST=localhost
MLD_DB_PORT=3306
MLD_DB_DATABASE=u586762424_domas
MLD_DB_USER=u586762424_domas
MLD_DB_PASSWORD=change-me

# Comma-separated SQL LIKE patterns for the department allowlist. The
# LedgerTrace MLD page is scoped to just these departments — every other
# row is hidden by the server. Defaults to Accounts + Finance if unset.
MLD_ALLOWED_DEPARTMENTS=%accounts%,%finance%

# ─── MLD S3 — DOMAS bucket for file previews and downloads ───
# The same access key/secret DOMAS itself uses. Region defaults to
# ap-south-1 and bucket defaults to domas-documents if unset.
MLD_AWS_ACCESS_KEY_ID=AKIA...
MLD_AWS_SECRET_ACCESS_KEY=...
MLD_AWS_REGION=ap-south-1
MLD_AWS_BUCKET=domas-documents
